<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night mode uses same dark theme by default -->
    <style name="Theme.Vibez" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_secondary</item>
        <item name="colorOnPrimary">@color/key_text_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
