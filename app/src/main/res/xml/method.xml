<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.voxtype.keyboard.SettingsActivity"
    android:isDefault="false">

    <!-- Default subtype - English -->
    <subtype
        android:label="@string/subtype_en"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- Greek -->
    <subtype
        android:label="@string/subtype_el"
        android:imeSubtypeLocale="el_GR"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />

    <!-- Spanish -->
    <subtype
        android:label="@string/subtype_es"
        android:imeSubtypeLocale="es_ES"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- French -->
    <subtype
        android:label="@string/subtype_fr"
        android:imeSubtypeLocale="fr_FR"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- German -->
    <subtype
        android:label="@string/subtype_de"
        android:imeSubtypeLocale="de_DE"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- Italian -->
    <subtype
        android:label="@string/subtype_it"
        android:imeSubtypeLocale="it_IT"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- Portuguese -->
    <subtype
        android:label="@string/subtype_pt"
        android:imeSubtypeLocale="pt_BR"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />

    <!-- Arabic -->
    <subtype
        android:label="@string/subtype_ar"
        android:imeSubtypeLocale="ar"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />

    <!-- Hindi -->
    <subtype
        android:label="@string/subtype_hi"
        android:imeSubtypeLocale="hi_IN"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />

    <!-- Chinese Simplified -->
    <subtype
        android:label="@string/subtype_zh"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />

</input-method>
