<?xml version="1.0" encoding="utf-8"?>
<!-- Secrets are encrypted with a device-bound Android Keystore key and cannot be restored on another
     device, so nothing is backed up or transferred. Use the in-app encrypted export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
