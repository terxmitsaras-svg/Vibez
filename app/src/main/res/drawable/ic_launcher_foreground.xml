<?xml version="1.0" encoding="utf-8"?>
<!--
    Vortext Logo: Vortex/spiral with letters A-I-V being pulled inward.
    The spiral arms curve clockwise toward the center.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background circle -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M54,54m-54,0a54,54 0,1 1,108 0a54,54 0,1 1,-108 0" />

    <!-- Outer vortex arm 1 (blue-purple) -->
    <path
        android:strokeColor="#7B61FF"
        android:strokeWidth="2.5"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:pathData="M54,10 C75,10 90,25 90,46 C90,67 75,82 54,82 C33,82 18,67 18,46" />

    <!-- Outer vortex arm 2 (cyan accent) -->
    <path
        android:strokeColor="#00D4FF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:pathData="M54,18 C71,18 84,31 84,48 C84,65 71,78 54,78" />

    <!-- Middle vortex ring -->
    <path
        android:strokeColor="#7B61FF"
        android:strokeWidth="1.8"
        android:strokeAlpha="0.7"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:pathData="M54,26 C67,26 76,35 76,48 C76,61 67,70 54,70 C41,70 32,61 32,48 C32,35 41,26 54,26" />

    <!-- Inner vortex ring -->
    <path
        android:strokeColor="#00D4FF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.6"
        android:fillColor="@android:color/transparent"
        android:pathData="M54,34 C63,34 70,41 70,50 C70,59 63,66 54,66 C45,66 38,59 38,50 C38,41 45,34 54,34" />

    <!-- Center vortex dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />

    <!-- Letter "V" being pulled in (outer, large) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeAlpha="0.9"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M22,18 L30,34 L38,18" />

    <!-- Letter "O" / orbit ring arc (mid position) -->
    <path
        android:strokeColor="#B0A0FF"
        android:strokeWidth="2.2"
        android:strokeAlpha="0.8"
        android:fillColor="@android:color/transparent"
        android:pathData="M70,22 C76,22 80,26 80,32 C80,38 76,42 70,42 C64,42 60,38 60,32 C60,26 64,22 70,22" />

    <!-- Letter "X" being pulled inward (inner position) -->
    <path
        android:strokeColor="#00D4FF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.85"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:pathData="M62,70 L72,82 M72,70 L62,82" />

    <!-- Vortex swirl lines (decorative) -->
    <path
        android:strokeColor="#7B61FF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.4"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:pathData="M30,75 C35,68 42,63 50,60" />

    <path
        android:strokeColor="#00D4FF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.4"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:pathData="M16,54 C18,47 23,42 30,39" />

</vector>
